# Macha 0.21.0
#
# Copy this file per node. Paths, advertise address and failure_domain are
# node-local. The cluster key contents and dht policy must match every node.
#
# Create state/cache/storage directories before starting the service. Storage
# paths are deliberately not auto-created: a missing mounted disk must not turn
# into an accidental directory on the root filesystem.

state_path: /var/lib/macha
key_file: /etc/macha.key

# Directory scanned for subsystem plugins (.so/.dylib). Defaults to this
# build's private plugin directory (e.g. /usr/lib/macha/plugins) when
# omitted. Uncomment only to override that default.
# plugin_path: /opt/macha/plugins

# ALL, DEBUG, INFO, WARN or ERROR. Default: INFO.
# ALL includes expensive per-object/FUSE/payload/extent/write trace output; DEBUG is low-volume operational diagnosis.
log_level: INFO

# Independent libav/FFmpeg threshold. FFmpeg messages are routed through the
# Macha logger, but this threshold is not limited by log_level above. Thus
# log_level: INFO + ffmpeg_log_level: DEBUG is valid and useful.
# QUIET, PANIC, FATAL, ERROR, WARN, INFO, VERBOSE, DEBUG or TRACE. Default: ERROR.
ffmpeg_log_level: ERROR

# Startup gate. Local-state recovery (journal replay, metadata materialisation,
# storage accounting) may take as long as it takes, as long as it keeps
# making progress. Only when recovery has been silent — no journal record
# parsed, no delta applied, no object scanned, no stage reached — for
# service_startup_no_progress_ms is the process treated as internally stalled:
# it logs known readiness state and terminates so the service supervisor
# (systemd Restart=on-failure) brings up a fresh instance. Default: 120000.
# service_startup_timeout_ms is an optional absolute ceiling on top of that;
# 0 (the default) disables it, so a slow but progressing recovery can never
# become a crash loop.
service_startup_no_progress_ms: 120000
service_startup_timeout_ms: 0

# Linux/glibc process-memory bound. Apply one allocator arena per RPi core by
# default instead of glibc's much larger CPU-derived allowance. This prevents
# short-lived codec threads from ratcheting retained process memory after each
# playback session. Accepted range: 1..64. Non-glibc platforms ignore it.
runtime:
  glibc_arena_max: 4
  retained_memory_bytes: 768M
  control_memory_reserve_bytes: 64M
  viewer_memory_reserve_bytes: 192M
  loader_memory_reserve_bytes: 64M

# Authoritative storage is split by correctness class. DATA holds media extents,
# artwork and other immutable payloads. CONTROL/METADATA has an independent
# priority quota and cannot be blocked by a full DATA backend.
storage:
  # Whether this node is ever a DATA placement owner or fallback holder.
  # false is the edge node: it serves the API and media to its own network
  # from its cache, publishes writes to the owners, and stores no extents, so
  # `data` may be omitted. auto resolves to false with no backends or when
  # the node turns out to accept no inbound connections (network.inbound_capable).
  hosts_extents: auto
  data:
    backends:
      - path: /mnt/media-a/macha-data
        limit: 10T
        reserve_free: 4G
      - path: /mnt/media-b/macha-data
        limit: 10T
        reserve_free: 4G
    # Objects at or below threshold are packed locally. Packing never changes
    # ObjectId, DHT ownership, replication, repair or GC. Set both to 0 to disable.
    packing:
      threshold: 1M
      target_size: 64M

  metadata:
    # Omit path to use <state_path>/metadata-objects.
    path: /var/lib/macha/metadata-objects
    limit: 4G
    packing:
      threshold: 1M
      target_size: 64M

# Independent best-effort read cache. It does not count as a DHT replica.
# SSD is a good fit. max_blocks is a block count, not a byte limit.
cache:
  path: /var/cache/macha
  max_blocks: 4096
  prefer_metadata: true

# Root ownership/mode are used only when a brand-new namespace is formed.
# They are then persisted in distributed metadata.
filesystem:
  root_uid: 0
  root_gid: 0
  root_mode: "0755"

# The mounted filesystem is a bounded local frontend. Kernel callbacks never
# wait synchronously for metadata publication, remote placement, repair or catalogue
# work. Accepted namespace/data state is journalled locally and published by
# asynchronous workers. Timeouts deliberately remain well below macFUSE's own
# daemon timeout; a request fails to the kernel rather than hanging the mount.
fuse:
  # Filesystem path to mount at. If omitted, Macha runs without a FUSE mount.
  mount_path: /srv/media

  allow_other: false

  # Durable FUSE admission state can be placed independently of state_path.
  # spool_path may hold the full unpublished byte backlog. The operation
  # journal is small descriptor/control state and may live on another device.
  # If omitted, spool_path defaults below state_path and the operation journal
  # defaults inside the resolved spool directory.
  spool_path: /var/spool/macha/fuse
  operation_journal_path: /var/lib/macha/fuse-operations.log

  entry_timeout_ms: 1000
  attr_timeout_ms: 1000
  negative_timeout_ms: 500
  absolute_request_timeout_ms: 15000
  timeouts:
    lookup_ms: 1000
    namespace_ms: 3000
    read_ms: 10000
    write_ms: 5000
    sync_ms: 5000
    lifecycle_ms: 2000
  request_workers: 24
  max_pending_requests: 4096
  # Aggregate heap ownership of copied writes waiting to enter the disk spool.
  max_pending_write_bytes: 32M
  commit_workers: 8
  # Compatibility setting retained for older configurations.
  foreground_commit_workers: 1
  # Genuine streaming/viewer activity receives the dominant relative service
  # share. FUSE is ingest/convenience traffic and always uses loader priority.
  # Either class borrows 100% of unused capacity while the other is idle.
  viewer_weight: 95
  loader_weight: 5
  publication_quiet_ms: 5000
  # A large file yields after each quantum so closed/smaller files make fair
  # progress. The in-flight budget caps the aggregate quanta admitted at once.
  publication_quantum_bytes: 32M
  publication_inflight_bytes: 256M
  publication_pipeline_bytes: 8M
  max_pending_operations: 4096
  # DataOp/checksum history plus one concurrent publication snapshot.
  max_operation_metadata_bytes: 64M

  # Retry budgets. A publication (or namespace operation) that keeps failing
  # backs off exponentially between attempts; once it has failed
  # max_failures times inside window_ms it is *parked* — kept on disk, shown
  # in status and GET /api/v1/manage/filesystem/parked-publications, and left
  # for an operator to retry or abandon — so one poisoned file can never hold
  # the loader queue or spin the log forever. The namespace queue cannot be
  # parked (it is ordered), so on exhaustion it surfaces the blocking
  # operation in status and keeps trying at the ceiling backoff.
  publication_retry_max_failures: 100
  publication_retry_window_ms: 1800000
  publication_retry_initial_backoff_ms: 250
  publication_retry_max_backoff_ms: 30000
  namespace_retry_max_failures: 200
  namespace_retry_window_ms: 1800000
  namespace_retry_initial_backoff_ms: 50
  namespace_retry_max_backoff_ms: 5000

  # Aggregate local write-back and recovery bounds. max_spool_bytes is the
  # durable burst/backlog budget, not an ENOSPC threshold: admission is fast
  # below half occupancy, then progressively tracks measured publication speed
  # and blocks at the bound until publication creates room. A physical
  # spool_reserve_free violation remains ENOSPC to protect the host filesystem.
  # Changes to these FUSE limits take effect after a server restart.
  max_spool_bytes: 16G
  spool_reserve_free: 2G
  max_orphan_bytes: 1G
  max_operation_journal_bytes: 256M

  hydration_priority: 2000
  read_ahead_extents: 2
  hint_lifetime_ms: 5000
  write_through_cache: true

  # Before starting cluster/storage services, detect an already-mounted Macha
  # FUSE filesystem at mount_path. If true, remove that stale Macha mount and
  # verify it disappeared. Unrelated filesystems are always refused.
  unmount_if_mounted: true
  # Make the host directory under mount_path immutable (chattr +i) before the
  # services start, so nothing -- root included -- can write into it while the
  # mount is absent or not yet up. Stray entries found there are logged and
  # reported as filesystem.mountpoint_stray_entries.
  fail_closed_mountpoint: true
  watchdog_interval_ms: 1000
  # How long to wait for this node's metadata replica to produce any
  # namespace at all before the mount reports a fault its supervisor can
  # retry and eventually show you. It bounds "no metadata has arrived",
  # not "recovery is slow": a progressing replay is never cut off by it.
  # 0 waits forever, which is what every release before 0.41.0 did.
  initial_namespace_timeout_ms: 600000

network:
  # listen is the local bind address. advertise is what peers connect to.
  listen: 0.0.0.0
  advertise: media-node-2.example.net
  port: 7437

  # Can peers connect *to* this node? false is the node behind CGNAT or a NAT
  # nobody may forward: it dials its peers, they answer over the sessions it
  # opened, and never dial it (advertise, upnp, external_ip and
  # connectivity_check are then irrelevant). auto asks a peer to dial back,
  # persists the answer under state_path/connectivity/ and re-checks it
  # periodically. A founding node (no bootstrap) must be reachable.
  inbound_capable: auto

  # Nodes sharing one physical/site failure domain should share this value.
  failure_domain: site-a

  heartbeat_ms: 5000
  dead_after_ms: 30000
  connect_timeout_ms: 2500

  # Variable transport frames are at most this large. Peers negotiate the lower
  # ceiling. Smaller values give finer pre-emption; extent_size is independent.
  max_frame_size: 256K

  # DEBUG observability only. These never cancel a healthy RPC; 0 disables.
  control_stall_notice_ms: 5000
  data_stall_notice_ms: 120000
  # A call that has made no progress (no bytes either way) for this long is
  # cancelled and fails with a transient error its caller retries under its
  # own retry policy, instead of waiting on the peer indefinitely. 0 disables.
  # Data transfers have their own stall/spill handling, so the data lane
  # deadline is off by default.
  control_no_progress_deadline_ms: 30000
  data_no_progress_deadline_ms: 0

  # Optional public ingress discovery. When a UPnP IGD mapping succeeds, Macha
  # advertises the gateway's external address and mapped port to cluster peers.
  # external_port: 0 requests the same external port as network.port.
  upnp:
    enabled: false
    external_port: 0
    discovery_timeout_ms: 2000
    lease_seconds: 0

  # Optional fallback when UPnP cannot supply a public address. This uses
  # https://checkip.amazonaws.com and assumes any required port forwarding is
  # already configured outside Macha.
  external_ip:
    enabled: false
    timeout_ms: 3000

  # Probe the effective advertised endpoint from this node after startup. A
  # failure can mean the port is closed OR that the gateway lacks NAT hairpin.
  connectivity_check:
    enabled: false
    timeout_ms: 3000

# Cluster policy. Keep replica counts identical everywhere and change them as a
# coordinated cluster operation. Every node is metadata-capable.
# `min_write_replicas` is the foreground DATA durability floor; `replicas` is
# the DATA convergence target restored by repair. `metadata_min_write_replicas`
# is the number of distinct active nodes required to publish metadata/control.
#
# extent_size is fixed once a namespace exists. It is a logical file-chunk
# ceiling and is unrelated to the physical small-object packing threshold.
dht:
  replicas: 3
  metadata_min_write_replicas: 2

  # DATA may publish after min_write_replicas durable authoritative copies.
  # Repair converges missing copies toward replicas. A full/offline/stalled
  # preferred owner falls through to the next deterministic capacity-aware
  # candidate. Metadata/control writes use their separate any-node write floor.
  min_write_replicas: 1
  write_stall_ms: 2500
  extent_size: 4M
  # Bound simultaneous blocking DATA work by bytes, while preserving headroom
  # which ingest and maintenance cannot consume. CONTROL uses separate lanes
  # and executors and does not enter this budget.
  data_inflight_bytes: 128M
  data_viewer_reserve_bytes: 32M
  # How long a DATA credit wait may make no progress before it fails instead
  # of waiting for ever. "No progress" means not one lease was released
  # anywhere for this long: under any real load releases happen constantly and
  # the window keeps resetting, so a waiter queued behind genuine work is never
  # disturbed. It fires only when the arbiter is wedged -- for example a caller
  # holding credit while acquiring more -- and then logs the class, size and
  # used/active/waiting counts rather than hanging silently. 0 waits for ever.
  data_credit_no_progress_deadline_ms: 120000
  read_ahead: 3
  metadata_cache_ms: 250
  # Process-memory ceiling for decoded metadata snapshots. Durable history
  # payloads stay disk-backed and are loaded only when required.
  metadata_materialization_cache_bytes: 128M
  # A DATA retention claim (e.g. accepting a metadata publication) checks
  # candidate placement in have_objects batches of this many extent IDs per
  # peer, not one have_object RPC per extent. Must fit within
  # network.max_frame_size (32 bytes/id plus a small header).
  retention_check_batch_size: 2000
  # Bound on simultaneous have_objects batches in flight, across all peers
  # combined, from a single retention claim -- caps fan-out against any one
  # peer no matter how large the publication.
  retention_check_concurrency: 8

# Speculative cache hydration. Hint engines are independent and their priorities
# are merged by a weighted-fair scheduler. Ordered runs stay sequential: a next
# episode is warmed from its beginning rather than by random extents.
hydration:
  enabled: true
  interval_ms: 100
  active_timeout_ms: 30000
  max_inflight: 4
  catalogue_lookahead: 1
  engines:
    read_ahead:
      enabled: true
      priority: 1000
    current_file:
      enabled: true
      priority: 700
    catalogue:
      enabled: true
      priority: 300

# Bootstrap may be one-way or symmetric. A configured joiner waits for a
# reachable bootstrap peer rather than inventing a new namespace alone.
bootstrap:
  - media-node-1.example.net:7437

maintenance:
  # Background work is byte-budgeted and adaptive. Foreground I/O wins.
  interval_ms: 1000
  foreground_quiet_ms: 2000
  busy_bandwidth_fraction: 0.0
  idle_bandwidth_fraction: 0.10
  cpu_target: 0.10
  # Loader/speculative DATA operations (publication, repair; one extent
  # each) active at once. 0 = half the hardware threads, minimum 1.
  background_concurrency: 0
  initial_bandwidth: 32M
  max_bandwidth: 0B       # 0 = no configured cap; observed rate still applies.
  # Proactive physical integrity scrub is a scheduled campaign, not continuous
  # idle work. The due time survives daemon restarts. Reads verify integrity too.
  scrub_fraction: 0.02
  scrub_interval_ms: 2592000000  # 30 days

  # A settled repair/rebalance/GC pass backs off instead of rescanning the
  # complete object set. Metadata/catalogue control verification remains capped
  # at a 30-second cadence independently of this data-plane backoff.
  no_progress_backoff_ms: 300000

  # Recently retired objects and otherwise-unreachable physical objects must
  # remain untouched for this long before reachability GC may reclaim them.
  # Retirement tombstones are pruned after the same grace period.
  garbage_grace_ms: 86400000

# Catalogue structure is CONTROL metadata: sharded content-addressed objects are
# durable on the metadata write floor and then converged to all active nodes.
# Artwork is ordinary DATA. The scanner and HTTP/JSON API are optional.
# Each scan provider owns the roots
# it is allowed to classify. Every enabled provider root must be readable for
# deletion reconciliation to run.
catalogue:
  scanner:
    enabled: false
    interval_ms: 21600000
    # Coalesce namespace create/write/rename/delete bursts before rescanning.
    # Sustained mutation cannot defer a pending rescan beyond rescan_max_delay_ms.
    rescan_debounce_ms: 10000
    rescan_max_delay_ms: 600000
    # Bound synchronous online metadata-provider work per scanner pass.
    # A completed batch continues later without blocking the whole scan indefinitely.
    max_provider_requests_per_scan: 32
    provider_batch_delay_ms: 30000
    max_artwork_bytes: 16M
    providers:
      movies:
        enabled: true
        roots:
          - /Movies
        # TMDB API Read Access Token, stored as the only content of this file.
        tmdb:
          enabled: true
          token_file: /etc/macha-tmdb.token
          language: en-GB
          image_size: w500

      tv:
        enabled: true
        roots:
          - /TV
        tmdb:
          enabled: true
          token_file: /etc/macha-tmdb.token
          language: en-GB
          image_size: w500

      music:
        enabled: true
        roots:
          - /Music
        # MusicBrainz requires a meaningful application contact; no API key.
        musicbrainz:
          enabled: true
          contact: https://github.com/tomdionysus/macha
          cover_size: "500"

        # Optional secondary provider. Discogs database search requires an
        # authenticated personal token. MusicBrainz remains first choice.
        discogs:
          enabled: false
          # token_file: /etc/macha-discogs.token

  api:
    enabled: true
    listen: 127.0.0.1
    port: 7438
    # Optional: the URL clients should use to reach this node's API (exposed
    # on every node in /api/v1/status's nodes[] as api_endpoint). listen/port
    # above describe the INNER bind; this describes the OUTER address, and the
    # two are independent on purpose.
    #
    # With a TLS-terminating proxy in front of the API, Macha serves plain
    # http on listen:port while clients must be told https on the proxy's
    # port -- neither the scheme nor the port of the outer address can be
    # derived from the bind, which is why it is stated here rather than
    # constructed by the client. Also covers NAT/port-forwarding.
    #
    # Scheme, host and optional port only. A PATH IS NOT SUPPORTED and is
    # rejected at startup: fronting a node at a subpath is not a deployment
    # this serves, and a client treating the value as an origin would drop the
    # path and 404 silently.
    #
    # Defaults to http:// this node's network.advertise (not listen, which is
    # conventionally a wildcard bind) and the port above.
    # advertised_endpoint: https://media-node-2.example.net:443
    # token_file: /etc/macha-api.token
    max_request_bytes: 8M

    # HTTP workers serve catalogue requests, direct media and HLS fragments.
    workers: 16
    max_queued_connections: 128
    client_io_timeout_ms: 30000
    stream_chunk_bytes: 256K

    # HTTP/1.1 keep-alive. A connection is reused for up to
    # keep_alive_max_requests before the server forces "Connection: close";
    # it is also closed early if it sits idle longer than
    # keep_alive_idle_timeout_ms waiting for the next request, or if other
    # connections are queued waiting for a worker.
    keep_alive_max_requests: 100
    keep_alive_idle_timeout_ms: 15000

    # Lifetime of a signed artwork capability URL (?exp=...&sig=...) embedded
    # in catalogue responses, letting a client load artwork via a plain
    # <img src> without a bearer header. Artwork is content-addressed/immutable
    # and lower-stakes than a playback session, so this deliberately outlives
    # a typical browsing session; an expired URL is recovered by re-fetching
    # the catalogue item, which the client already does on navigation.
    artwork_capability_ttl_ms: 86400000

# Persistent host-side ingest. Jobs may point at a regular file or recursively
# import a directory (for example, a temporarily mounted USB disk). The source
# path must be beneath one of source_roots unless it is an internal acquisition
# producer such as BitTorrent. Planned namespace destinations and byte offsets
# are checkpointed so jobs can pause/resume and survive daemon restarts.
ingest:
  enabled: false
  staging_path: /var/lib/macha/tmp/ingest
  staging_limit: 100G
  source_roots:
    - /mnt/import
    - /media
  copy_chunk_bytes: 1M
  checkpoint_bytes: 64M
  blocked_retry_ms: 5000
  # Jobs imported at once (1..64). Each holds its own publication writer, so
  # this bounds retained memory as much as throughput. Applied at start.
  max_concurrent_jobs: 10
  cleanup:
    # Macha-owned sources (currently torrent staging) are retained after a
    # successful ingest until the terminal job is explicitly cleared.
    delete_owned_source_on_clear: true
    # External sources such as USB/import directories are preserved by default.
    delete_external_source_on_clear: false
    # Cancelling an owned acquisition removes partial/staging payloads promptly.
    delete_owned_source_on_cancel: true

# Optional BitTorrent acquisition. The download engine is a subsystem plugin
# (libmacha-torrent.so, installed under plugin_path above): libtorrent-rasterbar
# >= 2.0 is detected at build time, but whether a given node can acquire is
# decided at run time by whether that file is present. With enabled: true and
# no plugin, the node reports the torrent subsystem as unavailable in
# GET /api/v1/status and answers 503 on /api/v1/torrents/* -- torrent search,
# which needs no engine, keeps working. Completed torrents are submitted to the
# generic ingest engine; torrent code does not write directly into the
# catalogue or Macha namespace.
torrent:
  enabled: false
  # Where the download engine binds, in libtorrent's syntax (an address or a
  # device name, e.g. "wlan0:6881"). Unset means the node's network.advertise
  # address: libtorrent's own default enumeration binds eth0 and loopback but
  # not wlan0, so a node whose only live link is wireless would otherwise get
  # a loopback-only session that reaches no peer and reports no error.
  # listen_interfaces: 10.44.1.51:6881
  listen_port: 6881
  max_active: 4
  max_download_rate: 0B  # 0 = unlimited
  max_upload_rate: 0B    # 0 = unlimited
  dht: true
  pex: true
  lsd: true

  # libtorrent maps its own listen port on the router. Both default on inside
  # libtorrent, and until these keys existed it did so no matter what the rest
  # of this file said -- a node with network.upnp.enabled false still had a
  # 6881 mapping created that nothing here mentioned and nothing could refuse.
  #
  # These are deliberately separate from network.upnp, which maps the cluster
  # RPC port through Macha's own UPnP client: different ports, different
  # reasons, and you may want one without the other. Turn both off if you
  # forward 6881 by hand, or if the router's UPnP is not to be trusted.
  upnp: true
  natpmp: true

  # Search providers are server-side only. Torznab responses are reduced to
  # typed result fields and acquisition URLs remain opaque to the frontend.
  search:
    providers: []
    # Replace [] with entries such as:
    #   - name: prowlarr
    #     type: torznab
    #     url: http://127.0.0.1:9696/api/v1/search
    #     api_key_file: /etc/macha-prowlarr.key
    #     max_results: 100

# The web client this node serves at its root. Off until `root` names a
# directory of built client assets. Any path that is not a file under that
# directory is answered with `index`, because a single-page application owns
# its own routing and a deep link has to reach it. Everything under /api stays
# the server's, 404s included, so an API call never comes back as HTML.
#
# The client is served without a bearer token -- a browser has none until the
# client has loaded and asked for one -- so `root` must contain only assets
# meant to be public. Nothing outside it is reachable: a request cannot climb
# out, and names beginning with a dot are refused.
# web:
#   enabled: true
#   root: /var/lib/macha/web
#   index: index.html

# Playback API and media transformation. Macha links libavformat/libavcodec
# directly and reads the pinned logical Macha file through a custom AVIOContext.
# No ffmpeg/ffprobe subprocess or loopback media source is involved.
streaming:
  enabled: true
  # temp_path: /var/lib/macha/tmp/playback  # spill only; active fragments are in memory
  max_sessions: 8
  max_video_transcodes: 1
  max_audio_transcodes: 4
  # Decoder threads per video transcode (1-16). max_video_transcodes bounds the
  # number of such pipelines that may run concurrently.
  video_decoder_threads: 2
  # x264 frame threads per video transcode; 0 = every hardware thread.
  video_encoder_threads: 0
  session_idle_ms: 1800000
  # Stop an abandoned physical remux/transcode pipeline after one minute
  # without a valid current-generation stream request. The logical session is
  # retained until session_idle_ms for retry/reconciliation.
  pipeline_idle_ms: 60000
  startup_timeout_ms: 15000
  segment_duration_ms: 4000
  max_ahead_segments: 8
  segment_memory_bytes: 64M

  # Bounded segment holds. The media playlist is a complete VOD list served
  # before any fragment exists, so a request for one that has not been produced
  # yet is ordinary: the server holds it rather than answering 404. These bound
  # that hold so control traffic stays serviceable.
  #
  # segment_hold_window is how far past the produced frontier a request may
  # still be held, in fragments. It matches max_ahead_segments deliberately: a
  # request inside it is one production is authorised to reach, and one outside
  # it is one nothing is working toward. Beyond it the answer is an immediate
  # retryable 503 rather than a wait.
  segment_hold_window: 8
  # Outstanding holds per session: one in flight plus one prefetch. A player
  # that queues thirty fragment requests gets one hold and twenty-nine prompt
  # refusals, rather than thirty sequential waits on the encoder.
  max_session_holds: 2
  # Outstanding holds across the whole node. Deliberately small: HttpServer
  # runs a fixed worker pool shared with Status, catalogue and manage traffic,
  # so a held request costs a worker for the whole of its wait and an unbounded
  # number of them stops the node answering anything. Raise this substantially
  # if HttpServer ever moves to an async runtime, where a hold costs a
  # continuation instead of a thread.
  max_concurrent_holds: 8
  # How long a held request may wait before answering. This must stay under
  # the tightest time-to-first-byte deadline across the clients: a held request
  # sends no bytes, so a client that gives up first never receives the answer
  # at all and takes its timeout path instead, which retries hard and then
  # fails. Known deadlines, each read from the shipped artifact rather than
  # from documentation: hls.js 10000
  # (fragLoadPolicy.default.maxTimeToFirstByteMs -- NOT the deprecated and
  # inert fragLoadingTimeOut of 20000), expo-video 10000 (OkHttp default read
  # timeout), React Native track player 8000 (media3
  # DEFAULT_READ_TIMEOUT_MILLIS), iOS AVFoundation unknown. 6000 clears the
  # tightest of those with margin for the WAN hop to the offsite node.
  segment_timeout_ms: 6000

  # Bound source inspection on distributed/slow media. probe_bytes and
  # probe_analyze_duration_ms limit libavformat analysis; probe_timeout_ms is a
  # wall-clock guard for the complete probe.
  probe_bytes: 8M
  probe_analyze_duration_ms: 5000
  probe_timeout_ms: 20000

# Authentication. Every HTTP route requires a Bearer token from
# POST /api/v1/session; what that session may do is the roles it carries.
#
# Users, passwords and roles are cluster state: every node holds the whole
# table and it converges by gossip. Verifying a password is a local lookup plus
# a KDF -- no RPC, no metadata, no catalogue -- so a node that is temporarily
# alone, or whose metadata has gone read-only, still logs people in. Nothing in
# the login path waits on a peer.
#
# The node that founds the cluster (the one with no bootstrap peers) creates
# two accounts on first start and never again:
#
#   root       every role. Its generated password is written to
#              <state_path>/genesis-root-password, mode 0600. Sign in, change
#              it, delete that file.
#   anonymous  media_viewer. This is what an unauthenticated visitor is.
#
# Neither can be renamed or deleted. Everything else about them is ordinary.
#
# If root's password is lost and no manage_users account can sign in, reset it
# on any node with that node stopped:
#
#   macha-users <state_path> <cluster.key> passwd root
#
# There is no recovery key and no recovery endpoint: one would be a standing
# unauthenticated path to the most privileged account, and anyone able to use
# it already has root on a node, where the command above does the same job.
#
# At least one account always holds manage_users: removing the role from the
# last account that has it, or deleting that account, is refused.
#
# Roles are capabilities, not a ladder -- importing does not imply managing:
#   media_viewer  read all media, playback, cluster status
#   importer      acquire content (torrents, ingest)
#   manager       files, namespaces, catalogue matches, identity-association
#                 reset
#   manage_users  add, edit and remove accounts
#
# Add accounts over the API, or offline with the node stopped:
#   macha-users /var/lib/macha /etc/macha/cluster.key create tom --roles manager
session:
  # Anonymous viewing. With this on, POST /api/v1/session with no credentials
  # mints a session bound to the "anonymous" account. Turn it off to require a
  # login for everything, including the web client -- note that televisions
  # have no practical way to type a password, so this is what decides whether
  # a TV can be used at all.
  #
  # What an anonymous visitor may *do* is not set here: it is the anonymous
  # account's roles, changed like any other account's, and takes effect on the
  # next session rather than on restart.
  allow_anonymous: true

  # A session is valid for this long from creation; there is no sliding
  # renewal, so the client re-mints when it expires.
  anonymous_ttl_ms: 2592000000
  max_sessions: 4096
  max_users: 4096

  # scrypt is deliberately expensive, and POST /api/v1/session is reachable
  # without a token, so password checks need a local brake. Neither of these is
  # replicated: they protect this node's CPU, nothing more. On a Pi, two
  # concurrent hashes is already most of a core each.
  max_concurrent_password_checks: 2
  failed_login_attempts: 5
  failed_login_lockout_ms: 30000
