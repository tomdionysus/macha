# Macha node configuration.
#
# One file per node. Paths, network.advertise and network.failure_domain are
# per node; the cluster key and the dht section must match on every node.
#
# Create the state, cache and storage directories before starting. Storage
# paths are never created: a disk that failed to mount must not become a
# directory on the root filesystem.

state_path: /var/lib/macha
key_file: /etc/macha.key

# Where subsystem plugins (.so/.dylib) are found. Default: this build's
# plugin directory, e.g. /usr/lib/macha/plugins.
# plugin_path: /opt/macha/plugins

# ALL, DEBUG, INFO, WARN or ERROR. Default: INFO. ALL adds per-object and
# per-request tracing; DEBUG is low-volume operational detail.
log_level: INFO

# FFmpeg's own threshold, independent of log_level. QUIET, PANIC, FATAL,
# ERROR, WARN, INFO, VERBOSE, DEBUG or TRACE. Default: ERROR.
ffmpeg_log_level: ERROR

# Startup. Recovery may take as long as it needs while it makes progress. If
# it makes none for service_startup_no_progress_ms, the process exits so its
# supervisor restarts it. service_startup_timeout_ms is an absolute ceiling;
# 0 (default) disables it.
service_startup_no_progress_ms: 120000
service_startup_timeout_ms: 0

runtime:
  # glibc allocator arenas (1..64); ignored elsewhere. Few arenas keep codec
  # threads from growing retained memory.
  glibc_arena_max: 4
  retained_memory_bytes: 768M
  control_memory_reserve_bytes: 64M
  viewer_memory_reserve_bytes: 192M
  loader_memory_reserve_bytes: 64M

# DATA holds media extents, artwork and other immutable objects. The metadata
# store has its own quota, so a full DATA backend cannot block it.
storage:
  # Whether this node stores DATA extents. false is an edge node: it serves
  # from its cache and publishes writes to the nodes that store them, and
  # needs no `data`. auto is false with no backends or when the node accepts
  # no inbound connections.
  hosts_extents: auto
  data:
    backends:
      - path: /mnt/media-a/macha-data
        limit: 10T
        reserve_free: 4G
      - path: /mnt/media-b/macha-data
        limit: 10T
        reserve_free: 4G
    # Objects at or below threshold are stored in pack files. Both 0 disables
    # packing. Packing changes nothing about identity, placement or repair.
    packing:
      threshold: 1M
      target_size: 64M

  metadata:
    # Default: <state_path>/metadata-objects.
    path: /var/lib/macha/metadata-objects
    limit: 4G
    packing:
      threshold: 1M
      target_size: 64M

# Local read cache; not a replica. An SSD suits it. max_blocks is a count of
# blocks, not bytes.
cache:
  path: /var/cache/macha
  max_blocks: 4096
  prefer_metadata: true

# Owner and mode of the root directory, used only when a new namespace is
# created.
filesystem:
  root_uid: 0
  root_gid: 0
  root_mode: "0755"

# The FUSE mount. Operations are journalled locally and answered at once;
# publication to the cluster runs behind them. Every request has a timeout
# below the kernel's, so the mount fails a request rather than hanging.
fuse:
  # Omit to run without a mount.
  mount_path: /srv/media

  allow_other: false

  # spool_path holds unpublished file data; the operation journal is small and
  # may live on another device. Defaults: a spool under state_path, the
  # journal inside the spool.
  spool_path: /var/spool/macha/fuse
  operation_journal_path: /var/lib/macha/fuse-operations.log

  entry_timeout_ms: 1000
  attr_timeout_ms: 1000
  negative_timeout_ms: 500
  absolute_request_timeout_ms: 15000
  timeouts:
    lookup_ms: 1000
    namespace_ms: 3000
    read_ms: 10000
    write_ms: 5000
    sync_ms: 5000
    lifecycle_ms: 2000
  request_workers: 24
  max_pending_requests: 4096
  # Memory held by written data waiting to enter the spool.
  max_pending_write_bytes: 32M
  commit_workers: 8
  # Data publication is loader work: while a viewer is active it gets
  # loader_weight time for every viewer_weight of the viewer's; otherwise it
  # runs freely. A viewer counts as active for publication_quiet_ms after its
  # last request. Namespace operations are not paced.
  viewer_weight: 95
  loader_weight: 5
  publication_quiet_ms: 5000
  # A large file yields after each quantum so smaller files progress; the
  # in-flight budget caps the quanta admitted at once.
  publication_quantum_bytes: 32M
  publication_inflight_bytes: 256M
  publication_pipeline_bytes: 8M
  # Files with an open publication writer at once. 0 derives it from
  # runtime.loader_memory_reserve_bytes, never fewer than commit_workers.
  publication_max_open_writers: 0
  # A publication waiting for memory fails and retries after this long with
  # no progress anywhere in the pipeline. 0 waits forever.
  publication_no_progress_deadline_ms: 30000
  max_pending_operations: 4096
  max_operation_metadata_bytes: 64M
  # Namespace operations published together in one commit.
  namespace_batch_operations: 256
  namespace_batch_bytes: 256K

  # Retries back off exponentially. A publication that fails more than
  # max_failures times within window_ms, or has not succeeded for
  # max_failing_ms (0 disables that limit), is parked: kept on disk and listed
  # at GET /api/v1/manage/filesystem/parked-publications for an operator to
  # retry or abandon. Namespace operations are ordered and cannot be parked:
  # the blocking one is shown in status and retried at the ceiling backoff.
  publication_retry_max_failures: 100
  publication_retry_window_ms: 1800000
  publication_retry_initial_backoff_ms: 250
  publication_retry_max_backoff_ms: 30000
  publication_retry_max_failing_ms: 3600000
  namespace_retry_max_failures: 200
  namespace_retry_window_ms: 1800000
  namespace_retry_initial_backoff_ms: 50
  namespace_retry_max_backoff_ms: 5000
  namespace_retry_max_failing_ms: 3600000

  # max_spool_bytes is a backlog budget, not an ENOSPC limit: writes are
  # admitted freely below half of it, then at the measured publication rate,
  # and wait at the bound. Breaching spool_reserve_free on the host filesystem
  # is ENOSPC. These limits take effect on restart.
  max_spool_bytes: 16G
  spool_reserve_free: 2G
  max_orphan_bytes: 1G
  max_operation_journal_bytes: 256M

  hydration_priority: 2000
  read_ahead_extents: 2
  hint_lifetime_ms: 5000
  write_through_cache: true

  # Remove a stale Macha mount at mount_path before starting. Any other
  # filesystem there is refused.
  unmount_if_mounted: true
  # Make the mount point directory immutable (chattr +i) so nothing can write
  # into it while the mount is down. Stray entries are logged and reported as
  # filesystem.mountpoint_stray_entries.
  fail_closed_mountpoint: true
  watchdog_interval_ms: 1000
  # How long to wait for any namespace to arrive before the mount reports a
  # fault. A recovery that is making progress is never cut off. 0 waits
  # forever.
  initial_namespace_timeout_ms: 600000

network:
  # listen is the bind address; advertise is what peers connect to.
  listen: 0.0.0.0
  advertise: media-node-2.example.net
  port: 7437

  # Whether peers can connect to this node. false (behind CGNAT, say): it
  # dials its peers and they answer over its sessions; advertise, upnp,
  # external_ip and connectivity_check are then unused. auto asks a peer to
  # dial back and keeps the answer under state_path/connectivity/. A node
  # with no bootstrap peers must be reachable.
  inbound_capable: auto

  # Nodes in one physical site share a value.
  failure_domain: site-a

  heartbeat_ms: 5000
  # How often telemetry is gossiped, so how stale a peer's view of this node
  # in /api/v1/status can be.
  telemetry_interval_ms: 10000
  dead_after_ms: 30000
  connect_timeout_ms: 2500

  # Largest transport frame; peers use the lower of their two values.
  max_frame_size: 256K

  # Log a call that has made no progress for this long (DEBUG). 0 disables.
  control_stall_notice_ms: 5000
  data_stall_notice_ms: 120000
  # Cancel a call that has made no progress for this long, with an error its
  # caller retries. 0 disables; the data lane has its own stall handling.
  control_no_progress_deadline_ms: 30000
  data_no_progress_deadline_ms: 0

  # Map network.port on the gateway by UPnP and advertise the external
  # address. external_port 0 asks for the same port.
  upnp:
    enabled: false
    external_port: 0
    discovery_timeout_ms: 2000
    lease_seconds: 0

  # When UPnP gives no address, learn it from https://checkip.amazonaws.com.
  # Port forwarding must already be in place.
  external_ip:
    enabled: false
    timeout_ms: 3000

  # After startup, connect to this node's own advertised endpoint. A failure
  # means a closed port or a gateway without NAT hairpinning.
  connectivity_check:
    enabled: false
    timeout_ms: 3000

# Cluster policy; must match on every node. Any node accepts a write on its
# own. replicas is the DATA copy count repair converges to. write_copies and
# metadata_write_copies are the copies sought before a write returns: with
# that many nodes present it returns on that many, with fewer it returns on
# what it has and repair delivers the rest. extent_size is fixed once a
# namespace exists.
dht:
  replicas: 3
  metadata_write_copies: 2

  # A full, offline or stalled owner falls through to the next candidate.
  write_copies: 1
  write_stall_ms: 2500
  extent_size: 4M
  # Blocking DATA work in flight, by bytes, with a reserve ingest and
  # maintenance cannot use. Control traffic does not count against it.
  data_inflight_bytes: 128M
  data_viewer_reserve_bytes: 32M

  # Disk pressure. Each operation is judged against what it should cost:
  # io_pressure_overhead_ms plus io_pressure_per_mib_ms per MiB. When the
  # moving average of actual over expected passes io_pressure_slowdown_percent,
  # speculative work stands aside, and so does the loader while a viewer is
  # present, down to io_pressure_min_background operations, until the average
  # falls below io_pressure_release_percent. A viewer is never held back. One
  # operation past io_pressure_outlier_percent of its own cost trips pressure
  # at once (0 disables that). io_pressure_slowdown_percent 0 disables the
  # mechanism.
  io_pressure_overhead_ms: 25
  io_pressure_per_mib_ms: 120
  io_pressure_slowdown_percent: 300
  io_pressure_release_percent: 150
  io_pressure_outlier_percent: 1000
  io_pressure_min_background: 1
  # A wait for DATA credit fails, logging the arbiter's state, if no credit is
  # released anywhere for this long. 0 waits forever.
  data_credit_no_progress_deadline_ms: 120000
  read_ahead: 3
  metadata_cache_ms: 250
  # Memory for decoded metadata snapshots.
  metadata_materialization_cache_bytes: 128M
  # Extent ids per presence question to a peer when a retention claim checks
  # placement; must fit in max_frame_size (32 bytes per id).
  retention_check_batch_size: 2000
  # Presence questions in flight at once for one claim, across all peers.
  retention_check_concurrency: 8

# Cache warming ahead of playback. Engines are scheduled by priority; ordered
# runs stay sequential, so a next episode is warmed from its start.
hydration:
  enabled: true
  interval_ms: 100
  active_timeout_ms: 30000
  max_inflight: 4
  catalogue_lookahead: 1
  engines:
    read_ahead:
      enabled: true
      priority: 1000
    current_file:
      enabled: true
      priority: 700
    catalogue:
      enabled: true
      priority: 300

# Peers to join through. A node with bootstrap peers waits for one to answer
# rather than founding a namespace of its own.
bootstrap:
  - media-node-1.example.net:7437

# Background work: repair, rebalance, scrub and garbage collection.
maintenance:
  interval_ms: 1000
  # Foreground I/O within this long counts as the node being busy.
  foreground_quiet_ms: 2000
  busy_bandwidth_fraction: 0.0   # rebalance and scrub only
  idle_bandwidth_fraction: 0.10
  # Repair is paced, never stopped: while a viewer, the mount or the loader is
  # busy it gets repair_weight time for every foreground_weight of theirs.
  # Both 1..10000.
  foreground_weight: 95
  repair_weight: 5
  cpu_target: 0.10
  # Background DATA operations at once. 0 is half the hardware threads.
  background_concurrency: 0
  initial_bandwidth: 32M
  max_bandwidth: 0B       # 0: no cap beyond the measured rate
  # The integrity scrub runs as a campaign every scrub_interval_ms, using
  # scrub_fraction of the bandwidth; its due time survives restarts.
  scrub_fraction: 0.02
  scrub_interval_ms: 2592000000  # 30 days
  # A pass that finds nothing to do waits this long before scanning again.
  no_progress_backoff_ms: 300000
  # The absence horizon. A node removes an object's bytes only after seeing it
  # unreferenced for this long itself, so a node away for less still finds
  # what its branch refers to. A node unheard of for this long is forgotten,
  # and retirement tombstones are pruned after it.
  garbage_grace_ms: 2592000000  # 30 days

# The media catalogue. Its structure is metadata, committed locally and
# replicated to every node; artwork is DATA. Each scan provider classifies the
# files under its roots, and every enabled root must be readable for removed
# files to be reconciled.
catalogue:
  scanner:
    enabled: false
    interval_ms: 21600000
    # A rescan waits for namespace changes to settle for rescan_debounce_ms,
    # and never longer than rescan_max_delay_ms.
    rescan_debounce_ms: 10000
    rescan_max_delay_ms: 600000
    # Provider requests per scan batch; the rest continue in later batches.
    max_provider_requests_per_scan: 32
    provider_batch_delay_ms: 30000
    max_artwork_bytes: 16M
    # A file whose path below its root contains one of these as a word
    # (ignoring case) is not catalogued.
    ignore_terms: [sample]
    providers:
      movies:
        enabled: true
        roots:
          - /Movies
        # token_file holds a TMDB API read access token and nothing else.
        tmdb:
          enabled: true
          token_file: /etc/macha-tmdb.token
          language: en-GB
          image_size: w500

      tv:
        enabled: true
        roots:
          - /TV
        tmdb:
          enabled: true
          token_file: /etc/macha-tmdb.token
          language: en-GB
          image_size: w500

      music:
        enabled: true
        roots:
          - /Music
        # MusicBrainz needs no key but requires a contact for the application.
        musicbrainz:
          enabled: true
          contact: https://github.com/tomdionysus/macha
          cover_size: "500"

        # Secondary music provider, tried after MusicBrainz. Needs a personal
        # access token.
        discogs:
          enabled: false
          # token_file: /etc/macha-discogs.token

  # The HTTP API and web client.
  api:
    enabled: true
    listen: 127.0.0.1
    port: 7438
    # The URL clients use to reach this node, published as api_endpoint in
    # /api/v1/status. Set it when a proxy or NAT is in front: behind a
    # TLS-terminating proxy, listen and port are the plain-HTTP bind and this
    # is the https address. Scheme, host and optional port; a path is refused
    # at startup. Default: http://<network.advertise>:<port>.
    # advertised_endpoint: https://media-node-2.example.net:443
    # token_file: /etc/macha-api.token
    max_request_bytes: 8M

    # One reactor thread owns the sockets. workers serve the data lane
    # (catalogue, playback, web assets, file reads); control_workers serve the
    # control lane (health, status, sessions, users), so a node busy serving
    # media still answers status.
    workers: 16
    control_workers: 2
    # Open connections. An idle connection costs a descriptor, not a thread.
    max_connections: 1024
    # Requests queued for a worker before the server answers 503.
    max_queued_requests: 256
    client_io_timeout_ms: 30000
    # Streaming bodies are sent in stream_chunk_bytes pieces, at most
    # staging_chunks ahead of a slow client.
    stream_chunk_bytes: 256K
    staging_chunks: 2

    # Keep-alive: a connection serves up to keep_alive_max_requests and is
    # closed after keep_alive_idle_timeout_ms idle.
    keep_alive_max_requests: 100
    keep_alive_idle_timeout_ms: 15000
    # Requests slower than this are logged with their route. A reactor pass
    # longer than reactor_stall_threshold_ms is counted in diagnostics.
    slow_request_threshold_ms: 1000
    reactor_stall_threshold_ms: 50

    # gzip for text bodies of at least compression_min_bytes (>= 64), level
    # 1..9. Media is never compressed. Web assets without a .gz sibling are
    # compressed on demand up to compression_max_asset_bytes (<= 64M). Turn it
    # off behind a proxy that compresses.
    compression: true
    compression_min_bytes: 1K
    compression_level: 6
    compression_max_asset_bytes: 4M

    # Lifetime of the signed artwork URLs in catalogue responses, which load
    # without a bearer token. Also the artwork's max-age, and how often its URL
    # changes.
    artwork_capability_ttl_ms: 2592000000

# Ingest: copies files or directory trees from the host into the namespace.
# A source must be under one of source_roots, unless it is the node's own
# acquisition (torrents). Jobs are checkpointed and survive restarts.
ingest:
  enabled: false
  staging_path: /var/lib/macha/tmp/ingest
  staging_limit: 100G
  source_roots:
    - /mnt/import
    - /media
  copy_chunk_bytes: 1M
  checkpoint_bytes: 64M
  blocked_retry_ms: 5000
  # Jobs imported at once (1..64); each holds a publication writer. Applied
  # at start.
  max_concurrent_jobs: 10
  cleanup:
    # Delete a source Macha owns (torrent staging) when its job is cleared.
    delete_owned_source_on_clear: true
    # Delete an external source (an import directory) when its job is cleared.
    delete_external_source_on_clear: false
    # Delete an owned source's partial data when its job is cancelled.
    delete_owned_source_on_cancel: true

# BitTorrent acquisition. The engine is the libmacha-torrent plugin under
# plugin_path; without it, torrents report unavailable in /api/v1/status and
# /api/v1/torrents/* answers 503, while search still works. Completed
# torrents are imported by ingest.
torrent:
  enabled: false
  # Where the engine binds, in libtorrent's syntax (an address or a device,
  # e.g. "wlan0:6881"). Default: network.advertise.
  # listen_interfaces: 10.44.1.51:6881
  listen_port: 6881
  max_active: 4
  # false: keep this node's jobs, take no new ones.
  accept_new_jobs: true
  # Remove a completed torrent (its jobs and staging data) this long after it
  # completes. Unset is never; 0 is at once; at most 86400000 (24 h).
  # remove_on_complete_after_ms: 3600000
  max_download_rate: 0B  # 0: unlimited
  max_upload_rate: 0B    # 0: unlimited
  # libtorrent's alert threshold, independent of log_level. DEBUG logs every
  # alert; ALL adds libtorrent's internal categories.
  log_level: INFO

  # Threads doing the torrent's file I/O. Their reads and writes are admitted
  # as loader work, so a download yields to a viewer on a busy disk.
  disk_threads: 2
  dht: true
  pex: true
  lsd: true

  # Port mapping of listen_port on the router by libtorrent, separate from
  # network.upnp (which maps the cluster port). Turn both off when forwarding
  # the port by hand.
  upnp: true
  natpmp: true

  # Search providers, queried by the server; results are typed fields and
  # acquisition URLs stay opaque to clients.
  search:
    providers: []
    # For example:
    #   - name: prowlarr
    #     type: torznab
    #     url: http://127.0.0.1:9696/api/v1/search
    #     api_key_file: /etc/macha-prowlarr.key
    #     max_results: 100

# The web client served at this node's root, from the built assets in
# `root`. Any path that is not a file there is answered with `index`, for the
# client's own routing; everything under /api stays the API's. Assets are
# served without a token, so `root` must hold only public files; dot names
# and paths outside it are refused.
# web:
#   enabled: true
#   root: /var/lib/macha/web
#   index: index.html

# Playback and transcoding, through linked FFmpeg libraries.
streaming:
  enabled: true
  # temp_path: /var/lib/macha/tmp/playback  # spill only; fragments are in memory
  # Sessions on this node, all accounts together. Keep it above
  # max_sessions_per_account.
  max_sessions: 64
  # Sessions one account may hold on this node; 0 disables the bound. A
  # client keeps a live and a standby session per viewer and more during a
  # failover, so set it generously; too low, and failover stops working
  # rather than reporting a limit. Keep it below max_sessions, whose refusal
  # sends clients to other nodes.
  max_sessions_per_account: 32
  max_video_transcodes: 1
  max_audio_transcodes: 4
  # Decoder threads per video transcode (1..16).
  video_decoder_threads: 2
  # Encoder threads per video transcode; 0 is every hardware thread.
  video_encoder_threads: 0
  session_idle_ms: 1800000
  # A session that has never served any stream object (playlist, fragment,
  # subtitle or Direct Play body) expires after this instead.
  session_unused_idle_ms: 120000
  # A transcode or remux pipeline with no request for its current generation
  # for this long is stopped; the session lives on until session_idle_ms.
  pipeline_idle_ms: 60000
  # A session idle this long gives up its transcode entitlement and asks for
  # it again on resume. Meaningful between pipeline_idle_ms and
  # session_idle_ms.
  transcode_entitlement_idle_ms: 300000
  startup_timeout_ms: 15000
  segment_duration_ms: 4000
  max_ahead_segments: 8
  segment_memory_bytes: 64M

  # A request for a fragment not yet produced is held until it is. Requests
  # more than segment_hold_window fragments past production are refused at
  # once with a retryable 500 segment_not_ready and Retry-After: 1.
  segment_hold_window: 8
  # Held requests per session; further ones are refused at once.
  max_session_holds: 2
  # Held requests across the node.
  max_concurrent_holds: 64
  # The longest a held request waits. Keep it below the shortest
  # time-to-first-byte deadline among the clients: hls.js 10000, expo-video
  # 10000, React Native track player 8000.
  segment_timeout_ms: 6000

  # Limits on inspecting a source: bytes and duration analysed, and a
  # wall-clock limit on the whole probe.
  probe_bytes: 8M
  probe_analyze_duration_ms: 5000
  probe_timeout_ms: 20000

# Sessions and accounts. Every API route needs a bearer token from
# POST /api/v1/session; a session can do what its account's roles allow.
#
# Accounts are cluster state held by every node and converged by gossip.
# Signing in is local: a node alone still signs people in.
#
# The node that founds the cluster creates two accounts on first start:
#   root       every role; its password is written to
#              <state_path>/genesis-root-password (mode 0600). Sign in,
#              change it, delete the file.
#   anonymous  media_viewer; what an unauthenticated visitor is.
# Neither can be renamed or deleted.
#
# Roles:
#   media_viewer  media, playback, cluster status
#   importer      torrents and ingest
#   manager       files, namespaces, catalogue matches, identity resets
#   manage_users  accounts
# At least one account always holds manage_users.
#
# Offline, with the node stopped:
#   macha-users <state_path> <cluster.key> passwd root
#   macha-users /var/lib/macha /etc/macha/cluster.key create tom --roles manager
session:
  # Allow sessions without credentials, bound to the anonymous account. What
  # such a session may do is that account's roles. Turning it off requires a
  # login everywhere, which a television cannot practically do.
  allow_anonymous: true

  # Sessions last this long from creation; there is no renewal.
  anonymous_ttl_ms: 2592000000
  max_sessions: 4096
  max_users: 4096

  # Sign-in runs scrypt and needs no token, so this node limits concurrent
  # password checks and locks an account out briefly after repeated failures.
  max_concurrent_password_checks: 2
  failed_login_attempts: 5
  failed_login_lockout_ms: 30000
