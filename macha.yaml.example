# Macha 0.6.1
#
# Copy this file per node. Paths, advertise address and failure_domain are
# node-local. The cluster key contents and dht policy must match every node.
#
# Create state/cache/storage directories before starting the service. Storage
# paths are deliberately not auto-created: a missing mounted disk must not turn
# into an accidental directory on the root filesystem.

state_path: /var/lib/macha
key_file: /etc/macha.key
mount_path: /srv/media

# ALL, DEBUG, INFO, WARN or ERROR. Default: INFO.
log_level: INFO

# Authoritative local DHT storage. Add as many independent backends as required.
storage:
  - path: /mnt/media-a/dht
    limit: 10T
  - path: /mnt/media-b/dht
    limit: 10T

# Independent best-effort read cache. It does not count as a DHT replica.
# SSD is a good fit. max_blocks is a block count, not a byte limit.
cache:
  path: /var/cache/macha
  max_blocks: 4096
  prefer_metadata: true

# Root ownership/mode are used only when a brand-new namespace is formed.
# They are then persisted in distributed metadata.
filesystem:
  allow_other: false
  root_uid: 0
  root_gid: 0
  root_mode: "0755"

network:
  # listen is the local bind address. advertise is what peers connect to.
  listen: 0.0.0.0
  advertise: media-node-2.example.net
  port: 7437

  # Nodes sharing one physical/site failure domain should share this value.
  failure_domain: site-a

  heartbeat_ms: 5000
  dead_after_ms: 30000
  connect_timeout_ms: 2500

  # Variable transport frames are at most this large. Peers negotiate the lower
  # ceiling. Smaller values give finer pre-emption; extent_size is independent.
  max_frame_size: 256K

  # DEBUG observability only. These never cancel a healthy RPC; 0 disables.
  control_stall_notice_ms: 5000
  data_stall_notice_ms: 120000

# Cluster policy. Keep replica counts identical everywhere. They may be changed
# by stopping the whole cluster, editing every node, then restarting it.
# 3/3 is a sensible three-node production starting point.
# For a two-node cluster use replicas: 2, metadata_replicas: 2; both nodes are
# then required for metadata writes.
#
# extent_size is fixed once a namespace exists. The compiled default is 16M.
# 4M is the current recommended media
# setting because it gives finer-grained reads, retries and rebalance.
dht:
  replicas: 3
  metadata_replicas: 3
  extent_size: 4M
  read_ahead: 3
  metadata_cache_ms: 250

# Speculative cache hydration. Hint engines are independent and their priorities
# are merged by a weighted-fair scheduler. Ordered runs stay sequential: a next
# episode is warmed from its beginning rather than by random extents.
hydration:
  enabled: true
  interval_ms: 100
  active_timeout_ms: 30000
  max_inflight: 4
  catalogue_lookahead: 1
  engines:
    read_ahead:
      enabled: true
      priority: 1000
    current_file:
      enabled: true
      priority: 700
    catalogue:
      enabled: true
      priority: 300

# Bootstrap may be one-way or symmetric. A configured joiner waits for a
# reachable bootstrap peer rather than inventing a new namespace alone.
bootstrap:
  - media-node-1.example.net:7437

maintenance:
  # Background work is byte-budgeted and adaptive. Foreground I/O wins.
  interval_ms: 500
  foreground_quiet_ms: 2000
  busy_bandwidth_fraction: 0.0
  idle_bandwidth_fraction: 0.50
  cpu_target: 0.35
  initial_bandwidth: 32M
  max_bandwidth: 0B       # 0 = no configured cap; observed rate still applies.
  scrub_fraction: 0.10

  # Committed garbage, including superseded catalogue snapshots/artwork, is
  # retained for this grace period before each node removes its local copy.
  garbage_grace_ms: 86400000

# The catalogue itself is cluster metadata and is always present on every node.
# The scanner and HTTP/JSON API are optional. Scanner roots should contain only
# media you want automatically classified. Every configured root must be
# readable for deletion reconciliation to run.
catalogue:
  scanner:
    enabled: false
    interval_ms: 21600000
    roots:
      - /Movies
      - /TV
      - /Music
    max_artwork_bytes: 16M
    providers:
      # TMDB API Read Access Token, stored as the only content of this file.
      tmdb:
        enabled: true
        token_file: /etc/macha-tmdb.token
        language: en-GB
        image_size: w500

      # MusicBrainz requires a meaningful application contact; no API key.
      musicbrainz:
        enabled: true
        contact: https://github.com/tomdionysus/macha
        cover_size: "500"

  api:
    enabled: true
    listen: 127.0.0.1
    port: 7438
    # token_file: /etc/macha-api.token
    max_request_bytes: 8M
